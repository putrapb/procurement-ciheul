# Salin ke .env. JANGAN commit .env.
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Kosongkan untuk SQLite (default). Untuk PostgreSQL/Supabase isi connection string POOLER:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Jika memakai transaction pooler (port 6543):
# DB_DISABLE_SERVER_SIDE_CURSORS=1

# Opsional (fitur AI extractor)
ANTHROPIC_API_KEY=
